          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Autoridad de cliente\", () => pm.expect(pm.response.json().rol).to.eql(\"ROLE_CLIENTE\"));"
