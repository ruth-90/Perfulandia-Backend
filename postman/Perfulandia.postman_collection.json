{
  "info": {
    "name": "Perfulandia · flujo local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecuta en orden con Perfulandia local. Completa credenciales antes de iniciar. Los pedidos de prueba quedan en H2."
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "url": "{{base_url_auth}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo_admin}}\",\n  \"password\": \"{{password_admin}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Rol admin\", () => pm.expect(pm.response.json().rol).to.eql(\"ADMINISTRADOR\"));",
                  "if (pm.response.code < 300) pm.environment.set(\"token_admin\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login cliente",
          "request": {
            "method": "POST",
            "url": "{{base_url_auth}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo_cliente}}\",\n  \"password\": \"{{password_cliente}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Rol cliente\", () => pm.expect(pm.response.json().rol).to.eql(\"CLIENTE\"));",
